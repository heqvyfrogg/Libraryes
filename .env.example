# Libraryes Environment Configuration

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_SECRET=change_this_to_a_secure_random_string_32chars

# Default Kobe Library Credentials (Optional - can also be set via Web UI)
LIBRARY_DEFAULT_USERCODE=
LIBRARY_DEFAULT_PASSWORD=

# Notification Webhooks (Optional: Discord, Slack, etc.)
NOTIFICATION_WEBHOOK_URL=

# External AI Provider API Keys (Optional: OpenAI, Google Gemini, Anthropic)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
